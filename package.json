{
  "name": "@onforge/shared",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Código compartido de la plataforma OnForge (UI, el kit Clear Sky, CRUD, el cliente de plataforma, helpers de worker). TypeScript crudo: lo compila el bundler de la app que lo consume.",
  "sideEffects": [
    "styles/*.css"
  ],
  "scripts": {
    "check:neutral": "node scripts/check-neutral.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "docs:gaps": "node scripts/gen-docs.mjs --gaps"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.162.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260302.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.170.41",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
